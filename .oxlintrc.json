{
	"$schema": "https://unpkg.com/oxlint/configuration_schema.json",
	"options": {
		"typeAware": true
	},
	"categories": {
		"correctness": "warn",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"no-control-regex": "off"
	},
	"overrides": [
		{
			"files": ["*.test.ts"],
			"rules": {
				"typescript/no-floating-promises": "off"
			}
		}
	]
}
