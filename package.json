{
	"name": "@oomfware/safe-idn",
	"version": "0.1.2",
	"description": "detect IDN homograph spoofing",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "https://codeberg.org/oomfware/safe-idn"
	},
	"files": [
		"dist/",
		"src/",
		"!src/**/*.bench.ts",
		"!src/**/*.test.ts"
	],
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"test": "node --test src/**/*.test.ts",
		"prepublishOnly": "pnpm run build"
	},
	"devDependencies": {
		"@types/node": "^25.3.0",
		"bumpp": "^10.4.1",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3"
	}
}
